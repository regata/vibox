{
  "name": "vibox",
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile"
  },
  "workspaceFolder": "/home/agent/vibox",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/agent/vibox,type=bind,consistency=cached",
  "mounts": [
    "source=vibox,target=/home/agent/.codex,type=volume"
    // "source=${localEnv:HOME}/.claude,target=/home/agent/.claude,type=bind",
    // "source=${localEnv:HOME}/.claude.json,target=/home/agent/.claude.json,type=bind"
  ],
  "runArgs": [
    "--rm",
    "--name=vibox"
  ],
  "remoteUser": "agent",
  "customizations": {
    "vscode": {
      "extensions": [
        // "anthropic.claude-code",
        "openai.chatgpt",
        "ms-python.python"
      ],
      "settings": {
        "terminal.integrated.scrollback": 100000,
        "editor.formatOnSave": true
      }
    }
  }
}
